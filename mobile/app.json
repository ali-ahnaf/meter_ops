{
  "expo": {
    "name": "Meter Ops",
    "slug": "meter-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.meterops.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "meterops",
    "platforms": [
      "android"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "067f6cfa-0e00-48be-aafc-e8b5ff9744da"
      }
    },
    "owner": "ahnaf123"
  }
}
